# Gyon Backend Environment Configuration

# Server Configuration
PORT=3002
NODE_ENV=production
HOST=0.0.0.0

# CORS Configuration
CORS_ORIGIN=http://localhost:4173,http://localhost:3000,http://localhost

# AI Configuration (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=30000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/gyon.log

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Database (if you add one later)
# DATABASE_URL=postgresql://username:password@localhost:5432/gyon

# External APIs (add your API keys here)
# GITHUB_API_KEY=your-github-api-key
# OPENAI_API_KEY=your-openai-api-key