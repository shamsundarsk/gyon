# Production Environment Variables for Backend
NODE_ENV=production
PORT=3002
HOST=0.0.0.0

# CORS Configuration - Will be updated with actual frontend URL
CORS_ORIGIN=https://gyon.vercel.app

# AI Configuration (Disabled for Railway free tier)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=30000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Security (Generate new secrets for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
SESSION_SECRET=your-super-secret-session-key-change-this-in-production